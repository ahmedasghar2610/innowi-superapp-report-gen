# Frontend → API base URL.
# Keep it RELATIVE (default): the browser calls same-origin /api/v1/*, which
# is handled by src/app/api/v1/[...path]/route.ts — it attaches the
# Authorization header from the httpOnly access-token cookie (auth can't work
# without this hop, since client-side JS never has the token) and forwards to
# the real API.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the Innowi Super App API runs; the /api/v1 and /api/auth route
# handlers forward here. This app runs on 3001 (see package.json), the API on
# 3000 — they are different origins, which is why the proxy hop exists.
API_ORIGIN=http://localhost:3000

# There is ONE backend. The website intake questionnaires used to be served by
# a separate FastAPI service on :8000 with its own base URL
# (NEXT_PUBLIC_WEBSITES_API_BASE_URL); that service has been merged into the
# API above and its endpoints now live at /api/v1/websites. The variable is
# gone — do not set it, it is no longer read.

# Where the public site template (nextjs-site) is served. Used only to build
# the "view live site" link and to preview the template's own /images/* paths;
# nothing is fetched from it.
NEXT_PUBLIC_SITE_TEMPLATE_URL=http://localhost:5050

# --- Website module: "Clone a Website" engine (src/features/site-builder) ---
# Only needed on hosts that cannot run Chromium locally. WebSocket URL of a
# hosted browser (e.g. Browserless) the crawler connects to instead of
# launching a local Chromium/Chrome/Edge. Leave unset to use the local browser.
# PLAYWRIGHT_WS_ENDPOINT=wss://production-sfo.browserless.io?token=YOUR_TOKEN

# Skip downloading a local Chromium during npm install when using a remote
# browser via PLAYWRIGHT_WS_ENDPOINT above.
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
