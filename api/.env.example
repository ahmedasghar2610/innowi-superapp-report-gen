# -----------------------------------------------------------------------------
# Innowi Super App API — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL
# The app connects through PgBouncer/pooled URL at runtime; Prisma Migrate needs
# a DIRECT (unpooled) connection. Keep both.
# -----------------------------------------------------------------------------
# Runtime (pooled) connection used by the Prisma Client
DATABASE_URL="postgresql://innowi_app:change_me@localhost:5432/innowi"

# Direct connection used by `prisma migrate` / `prisma db push` (no pooler)
DIRECT_URL="postgresql://innowi_migrator:change_me@localhost:5432/innowi"

# Shadow database used by `prisma migrate dev` to detect drift (dev only)
SHADOW_DATABASE_URL="postgresql://innowi_migrator:change_me@localhost:5432/innowi_shadow?schema=public"


# -----------------------------------------------------------------------------
# Auth / JWT (RBAC)
# Generate strong random secrets, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# NEVER reuse the same secret for access and refresh tokens; NEVER commit real values.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace_with_a_random_64_char_hex_secret_______________________"
JWT_REFRESH_SECRET="replace_with_a_different_random_64_char_hex_secret____________"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Bootstrap Super Admin (used by `npm run seed:admin`)
# Change the password immediately after first login.
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL="superadmin@innowi.com"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# -----------------------------------------------------------------------------
# CORS — browser origins allowed to call this API directly.
# The Super App calls it cross-origin (different port), and the public site
# template calls GET /api/v1/websites/<slug>. Comma-separated, or a JSON array.
# "*" allows any origin; browsers reject a wildcard on credentialed requests,
# so keep it to a real list outside local development.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5050,http://127.0.0.1:5050

# -----------------------------------------------------------------------------
# File storage (Step 10) — where uploaded documents and brand assets live.
# Relative paths resolve against the API process cwd. Back this directory up.
# -----------------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# Security hardening (ported from Final-MVP)
# -----------------------------------------------------------------------------
# Fernet key used to encrypt third-party credentials at rest
# (app/common/security/crypto.py). Generate ONCE and keep it in a password
# manager as well — losing it means re-entering every stored credential:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also required by the Ops CRM credentials vault (Library → Credentials).
CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Ops CRM
# -----------------------------------------------------------------------------
# Timezone whose Saturday/Sunday the ticket SLA clock skips
# (app/modules/ops/sla.py). Default Asia/Karachi.
# OPS_SLA_TIMEZONE=Asia/Karachi
# SLA at-risk / breached alerts (the bell) are checked every 5 minutes inside
# the API. Set to false to turn the background check off.
# OPS_SLA_ALERTS=true

# Send Strict-Transport-Security. Set to true once the API is served over
# HTTPS (production). In production the app refuses to start when this is off.
ENABLE_HSTS=false

# Public site template (nextjs-site) origin. When a merchant's managed website
# goes live, its Profile `websiteUrl` is set to <SITE_TEMPLATE_URL>/<slug>.
SITE_TEMPLATE_URL=http://localhost:5050

# Microsoft 365 (Teams + Outlook) — from the Entra app registration. Settings →
# Integrations shows "Keys added" once all three are set; nothing uses them yet.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Fathom meeting notes (Ops CRM -> Meetings). API key: Fathom -> Settings -> API
# Access. Webhook secret (whsec_...) is shown when you add a webhook pointing at
# https://<api-host>/api/v1/integrations/fathom/webhook - only needed for
# instant delivery; "Sync from Fathom" works with the API key alone.
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Google Business Profile (Web & Search → GBP). From the Google Cloud project
# that has Business Profile API access: APIs & Services → Credentials →
# OAuth client ID (type "Web application"). Add GBP_OAUTH_REDIRECT_URI to that
# client's "Authorized redirect URIs" exactly as written, and the Super App's
# address (http://localhost:3001) to "Authorized JavaScript origins".
# CREDENTIAL_ENCRYPTION_KEY (above) must be set too — the Google token is
# stored encrypted with it. After restarting the API, a manager clicks
# "Connect Google Business Profile" on the GBP page.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Unset = <API_PUBLIC_URL or http://localhost:3000>/api/v1/integrations/gbp/callback
GBP_OAUTH_REDIRECT_URI=
# Where the browser returns after the Google sign-in (the Super App).
# Unset = APP_WEB_URL
GBP_APP_URL=
# Optional: days of history on the first sync (max ~540), request pacing.
# GBP_HISTORY_DAYS=540
# GBP_REQUESTS_PER_MINUTE=240
# Daily automatic refresh inside the API (default on, 06:00 Asia/Karachi).
# GBP_AUTO_SYNC=true
# GBP_AUTO_SYNC_HOUR=6
# GBP_TIMEZONE=Asia/Karachi

# -----------------------------------------------------------------------------
# Google Ads reporting (Modules → Ads). Replaces the n8n "Google Ads Reporting"
# workflow + Google Sheet. Uses the SAME Google OAuth client as GBP above:
#   1. In that Google Cloud project, enable "Google Ads API".
#   2. Add ADS_OAUTH_REDIRECT_URI to the OAuth client's "Authorized redirect URIs".
#   3. Developer token: Google Ads manager account → Tools → API Center.
#      (The token that was in the n8n workflow was shared in plain text —
#      reset it there first and put the new one here only.)
#   4. GOOGLE_ADS_LOGIN_CUSTOMER_ID = the manager (MCC) account, digits only
#      (the sheet's "MANAGER ID").
# Then a manager clicks "Connect Google Ads" on the Ads page (sign in with a
# Google user that has access to the manager account).
# -----------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Unset = <API_PUBLIC_URL or http://localhost:3000>/api/v1/integrations/google-ads/callback
ADS_OAUTH_REDIRECT_URI=
# Unset = APP_WEB_URL
ADS_APP_URL=
# Optional:
# GOOGLE_ADS_API_VERSION=v24
# ADS_HISTORY_DAYS=400        # first sync: days of history per account
# ADS_REFRESH_DAYS=14         # every sync re-reads the last N days (late conversions)
# ADS_AUTO_SYNC=true          # daily refresh inside the API
# ADS_AUTO_SYNC_HOUR=7
# ADS_TIMEZONE=Asia/Karachi
# ADS_BUDGET_TOLERANCE_PCT=10 # Budget Mismatch alert threshold
# ADS_STALE_HOURS=48          # Sync Issue alert when an account is older than this

# ---------------------------------------------------------------- SEO ----
# PageSpeed Insights API key (Google Cloud project "Super App" -> APIs & Services
# -> Credentials -> Create credentials -> API key; restrict it to "PageSpeed
# Insights API"). Gives the mobile speed score + Core Web Vitals on SEO pages.
# Leave empty until you have the key; restart the API after filling it in.
PAGESPEED_API_KEY=

# ------------------------------------------------- Hosting (shared database) ----
# On the shared Supabase database every schema is renamed at runtime
# (profiling -> superapp_profiling ...), see app/db/schemas.py.
# DB_SCHEMA_PREFIX=superapp_
# ALEMBIC_VERSION_SCHEMA=superapp_meta
# DB_POOL_MODE=null              # serverless: no idle pool per instance
# API_PUBLIC_URL=https://superapp-api-test.vercel.app   # this API's public origin
# APP_WEB_URL=http://localhost:3001                      # the web app (invite / quote links, OAuth returns)

# -------------------------------------- Background work (app/common/jobs.py) ----
# inline = run syncs inside the request + scheduler calls POST /api/v1/jobs/{job}
# (serverless); background = asyncio tasks + in-process daily loops (a server).
# Unset: inline on Vercel / AWS Lambda, background elsewhere.
# JOBS_MODE=
# JOBS_TIME_BUDGET_S=600
# JOBS_STALE_MINUTES=15
# JOBS_CRON_TOKEN=               # unset = SALESFORCE_SYNC_TOKEN (sql/jobs_cron.sql)
# OPS_SLA_ALERTS=true

# ----------------------------------------------- Uploads in Supabase Storage ----
# Set both to keep uploads in a private bucket instead of STORAGE_DIR (which is
# /tmp on Vercel and doesn't last). The key stays server-side.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=superapp-files

# ------------------------------------------------- Sales / quotes / assistant ----
# SALESFORCE_LOGIN_URL=          # e.g. https://innowi33.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_SYNC_TOKEN=         # scheduler secret (X-Sync-Token)
# RESEND_API_KEY=                # quote / invite e-mails
# QUOTES_TEAMS_WEBHOOK_URL=
# REQUESTS_TEAMS_WEBHOOK_URL=      # optional: Teams post for every new team request
# REQUESTS_EMAIL_FROM=Innowi Super App <superapp@myinnowi.com>
# OPS_TEAMS_FLOW_URL=            # Power Automate "Super App – Notify" HTTP URL (Teams DMs, alerts channel, meetings)
# OPS_TEAMS_FLOW_SECRET=         # the x-superapp-key value the flow checks
# OPS_TEAMS_TIMEZONE=Asia/Karachi  # time zone used in the flow's meeting step
# OPS_EMAIL_FROM=                # Ops CRM e-mails via Resend; unset = REQUESTS_EMAIL_FROM
# OPS_DIGEST_HOUR=9              # daily Teams digest (POST /api/v1/jobs/ops-digest)
# ASSISTANT_API_URL=             # the assistant stays off until URL, key and model are set
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=
# ASSISTANT_API_HEADERS={}       # JSON object of extra request headers
