# Where the Website Intake endpoints live.
#
# These used to be a standalone FastAPI service on :8000. That service has been
# merged into the Innowi Super App API, so the endpoints are now
# /api/v1/websites on port 3000. GET /api/v1/websites/<slug> is public —
# this template needs no token to render a page.
WEBSITE_API_URL=http://localhost:3000/api/v1

# Seconds to cache an API response. 0 re-reads on every request, so an edit in
# the Super App shows on the next refresh. Raise it in production.
SITE_REVALIDATE=0

# The slug served at "/". Left unset on purpose: "/" then returns 404 and every
# site is reached at its own /<slug>, so no merchant gets a privileged URL.
# Set it only when this deployment serves a single merchant.
# DEFAULT_SITE=primo-cafe

# Optional. Only needed for `generateStaticParams` to pre-render slugs that
# exist solely in the API: listing websites requires the `website.view`
# capability now. Leave it unset — with `dynamicParams = true` those pages
# still render on demand.
# WEBSITE_API_TOKEN=

# This project runs on port 5050 (see package.json) so it never collides with
# the Super App (3001) or the API (3000). If you move it, update
# NEXT_PUBLIC_SITE_TEMPLATE_URL in the Super App's .env.local so its
# "Visit site" buttons still point here.

# /<slug>/admin visual editor. "false" turns it off: /admin returns 404 and
# pages saved from the editor are ignored, so every site is built from its
# form answers again (the saved edits stay in the database).
# SITE_EDITOR_ENABLED=true

# Where this app can reach itself (used to snapshot a page for the editor).
# Defaults to the incoming request's origin; set it when that isn't reachable
# from the server itself (e.g. behind a proxy).
# SITE_INTERNAL_URL=http://localhost:5050
